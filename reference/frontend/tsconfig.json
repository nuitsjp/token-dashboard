{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "skipLibCheck": true, "esModuleInterop": true,
    "resolveJsonModule": true, "isolatedModules": true,
    "types": ["vite/client", "vitest/globals"],
    "baseUrl": ".", "paths": {
      "@bindings/*": ["bindings/*"],
      "@notes-service": ["bindings/wailstemplate/internal/notes/service.ts"]
    }
  },
  "include": ["src", "bindings", "tests", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}

{
  "name": "wails-template-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "vite",
    "routes": "tsr generate",
    "typecheck": "npm run routes && tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:dev": "npm run routes && vite build --mode development",
    "lint": "eslint src tests",
    "format": "prettier --write src tests *.ts *.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mantine/core": "8.3.5",
    "@mantine/hooks": "8.3.5",
    "@tanstack/react-query": "5.90.2",
    "@tanstack/react-router": "1.132.0",
    "@wailsio/runtime": "3.0.0-beta.23",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@playwright/test": "1.56.0",
    "@tanstack/router-cli": "1.132.0",
    "@tanstack/router-plugin": "1.132.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.15.33",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.0.0",
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.4.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vite": "8.0.13",
    "vitest": "4.1.0"
  }
}

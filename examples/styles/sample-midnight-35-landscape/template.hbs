<main class="service-display landscape" aria-label="Service usage and limits">
  {{#if service}}{{#with service}}
  <header class="page-head">
    {{#if icon}}<img class="service-icon" src="{{icon}}" alt="" />{{else}}<span class="service-initial">{{initial}}</span>{{/if}}
    <strong class="service-name">{{provider}}</strong><span class="plan">{{plan}}</span>
  </header>
  <div class="service-body" data-both="{{both}}" data-tokens="{{showTokens}}" data-limits="{{showLimits}}">
    {{#if showTokens}}<section class="service-tokens" aria-label="Service total">
      <div class="section-label">Service total</div>
      {{#each tokens}}<article class="token-period" style="--token-font-size: {{tokensFontSize}}px">
        <div class="period-line"><span>{{label}}</span><span class="token-cost">{{costText}}</span></div>
        <strong class="token-value">{{tokensText}}</strong>
      </article>{{/each}}
    </section>{{/if}}
    {{#if showLimits}}<section class="service-limits" aria-label="Usage Limits">
      {{#if message}}<div class="empty-limits">{{message}}</div>{{else}}
      <div class="circles" data-count="{{circles.length}}">
      {{#each circles}}<div class="circle">
        <svg class="gauge" viewBox="0 0 200 200">
        {{#each windows}}<g data-window-id="{{id}}">
          <path class="gauge-track" pathLength="100" d="{{#if @first}}M 36.3604 163.6396 A 90 90 0 1 1 163.6396 163.6396{{else}}M 49.0883 150.9117 A 72 72 0 1 1 150.9117 150.9117{{/if}}" />
          {{#if hasRemaining}}<path class="gauge-fill tone-{{tone}}" pathLength="100" stroke-dasharray="{{remainingPercent}} 100" d="{{#if @first}}M 36.3604 163.6396 A 90 90 0 1 1 163.6396 163.6396{{else}}M 49.0883 150.9117 A 72 72 0 1 1 150.9117 150.9117{{/if}}" />{{/if}}
        </g>{{/each}}
        <foreignObject x="28" y="{{#if double}}52{{else}}73{{/if}}" width="144" height="100">
          <div xmlns="http://www.w3.org/1999/xhtml" class="percentages">{{#each windows}}<div class="percentage"><strong>{{percentText}}</strong><span>{{durationLabel}}</span></div>{{/each}}</div>
        </foreignObject>
        </svg>
        <div class="circle-meta">{{#if showName}}<strong class="group-name">{{name}}</strong>{{/if}}
          {{#each windows}}<div class="reset-row"><span>{{durationLabel}}</span><svg class="clock" viewBox="0 0 16 16"><circle cx="8" cy="8" r="7" /><path d="M8 3.6V8L11.6 10.4" /></svg><span>{{resetText}}</span></div>{{/each}}
        </div>
      </div>{{/each}}
      </div>
      {{/if}}
    </section>{{/if}}
  </div>
  <footer class="page-foot"><span>MIDNIGHT / USAGE</span><span>{{number}} / {{count}}</span></footer>
  {{/with}}{{else}}<div class="waiting">{{serviceMessage}}</div>{{/if}}
</main>

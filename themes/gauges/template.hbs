<main class="display" aria-label="Token usage and limits">
  {{#if available}}
    <section class="tokens" aria-label="Tokens">
      {{#each tokens}}
        <div class="token-period">
          <span class="period-label">{{label}}</span>
          <strong class="token-count">{{tokensText}}</strong>
          <span class="token-cost">{{costText}}</span>
        </div>
      {{/each}}
    </section>
    <section class="panels" aria-label="Usage Limits">
      {{#each gaugePanels}}
        <article class="panel" style="grid-column: span {{span}}">
          <header class="provider-heading">
            {{#if icon}}<img class="provider-icon" src="{{icon}}" alt="" />{{/if}}
            <strong class="provider-name">{{provider}}</strong>
            <span class="provider-plan">{{plan}}</span>
          </header>
          <div class="circles">
            {{#each circles}}
              <div class="circle">
                <svg class="gauge" viewBox="0 0 200 200" aria-label="{{name}} remaining">
                  {{#each windows}}
                    <g class="window" data-window-id="{{id}}">
                      <path class="gauge-track" pathLength="100"
                        d="{{#if @first}}M 36.3604 163.6396 A 90 90 0 1 1 163.6396 163.6396{{else}}M 49.0883 150.9117 A 72 72 0 1 1 150.9117 150.9117{{/if}}" />
                      {{#if hasRemaining}}
                        <path class="gauge-fill tone-{{tone}}" pathLength="100" data-meter-fill
                          stroke-dasharray="{{remainingPercent}} 100"
                          d="{{#if @first}}M 36.3604 163.6396 A 90 90 0 1 1 163.6396 163.6396{{else}}M 49.0883 150.9117 A 72 72 0 1 1 150.9117 150.9117{{/if}}" />
                      {{/if}}
                    </g>
                  {{/each}}
                  <foreignObject x="20" y="{{#if double}}65{{else}}81{{/if}}" width="160" height="75">
                    <div xmlns="http://www.w3.org/1999/xhtml" class="percentages">
                      {{#each windows}}
                        <div class="percentage-row"><strong>{{percentText}}</strong><span>{{durationLabel}}</span></div>
                      {{/each}}
                    </div>
                  </foreignObject>
                  {{#if showName}}<text class="group-name" x="100" y="{{#if double}}186{{else}}190{{/if}}" text-anchor="middle">{{name}}</text>{{/if}}
                </svg>
                <div class="reset-rows">
                  {{#each windows}}
                    <div class="reset-row">
                      <strong class="duration-label">{{durationLabel}}</strong>
                      <svg class="clock" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7" /><path d="M 8 3.6 V 8 L 11.6 10.4" /></svg>
                      <span>{{resetText}}</span>
                    </div>
                  {{/each}}
                </div>
              </div>
            {{/each}}
          </div>
        </article>
      {{/each}}
    </section>
  {{else}}
    <div class="waiting">{{waitingMessage}}</div>
  {{/if}}
</main>
